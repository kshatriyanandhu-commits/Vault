# -----------------------------------------------------------------------------
# Argus Vault — environment variables
# Copy this file to `.env.local` and adjust the values.
# -----------------------------------------------------------------------------

# PostgreSQL connection string used by Drizzle at runtime and by drizzle-kit.
# Local dev example for the project-local cluster documented in the README:
DATABASE_URL=postgres://postgres:argus_local_dev@127.0.0.1:5433/argus_vault

# Pepper mixed into the SHA-256 hash of client IP addresses before they are
# stored. Raw IPs are never persisted. Use a long random string; changing it
# invalidates previously stored (already hashed) ip_hash values.
SESSION_PEPPER=replace-with-a-long-random-string

# Admin provisioning — consumed only by `npm run db:seed:admin`.
# Admin accounts can NOT be created through public sign-up.
ADMIN_EMAIL=admin@argus.local
ADMIN_NAME=Argus Administrator
ADMIN_PASSWORD=replace-with-a-strong-admin-master-password

# Optional demo account + sample credentials created by `npm run db:seed:demo`.
# Delete these lines to skip the demo seed.
DEMO_EMAIL=demo@argus.local
DEMO_NAME=Demo Operator
DEMO_PASSWORD=demo-master-password-change-me

# Optional: number of PBKDF2 iterations used for client-side vault-key
# derivation. Leave unset to use the built-in default (600000, OWASP guidance
# for PBKDF2-HMAC-SHA-256). Changing this value makes existing vaults
# undecryptable unless the same iteration count is kept.
# VAULT_KDF_ITERATIONS=600000
